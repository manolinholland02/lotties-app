    "build:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "test:maestro": "maestro test .maestro",
    "setup-app": "node scripts/setup-app.mjs",
    "prepare": "node scripts/setup-app.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "testTimeout": 15000
  }
